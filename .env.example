# Docker Compose will set its own DATABASE_URL for the backend service.
# This file is for non-Docker local development.

DATABASE_URL=postgresql+psycopg://contractguard:contractguard@localhost:5432/contractguard
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=60

# Frontend local override (optional)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend LLM assistant (optional overrides)
CONTRACTGUARD_LLM_MODEL=qwen2.5:7b
CONTRACTGUARD_OLLAMA_BASE_URL=http://localhost:11434
CONTRACTGUARD_LLM_TIMEOUT_SECONDS=120
CONTRACTGUARD_LLM_WORD_MIN=70
CONTRACTGUARD_LLM_WORD_MAX=80
CONTRACTGUARD_LLM_REPORT_FILE=build/backend_llm_report.txt
